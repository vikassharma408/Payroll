// Indian Payroll & Salary Register - Prisma schema
// NOTE: SQLite does not support native enums, so regime/status/category fields
// are modeled as String columns constrained by TS union types + zod at the
// application layer (see lib/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Company / Users
// ---------------------------------------------------------------------------

model Company {
  id            String   @id @default(cuid())
  name          String
  address       String?
  pan           String?
  tan           String?
  logoUrl       String?
  bankName      String?
  bankAccountNo String?
  bankIfsc      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | HR | ACCOUNTS | VIEWER
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Financial Year & Tax Rule Engine
// ---------------------------------------------------------------------------

model FinancialYear {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "2025-26"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  taxRuleSets             TaxRuleSet[]
  employeeSalaryStructure EmployeeSalaryStructure[]
  investmentDeclarations  InvestmentDeclaration[]
  previousEmployerIncomes PreviousEmployerIncome[]
  payrollRuns             PayrollRun[]
}

// One TaxRuleSet per (financialYear, regime, effectiveFrom). The engine picks
// the latest effective rule set <= the calculation date, so a mid-year
// amendment can be modeled without touching historical calculations.
model TaxRuleSet {
  id              String        @id @default(cuid())
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  regime          String // OLD | NEW
  effectiveFrom   DateTime
  isActive        Boolean       @default(true)

  standardDeduction      Int // Section 16(ia)
  cessRate               Float // Health & Education Cess, e.g. 0.04
  rebateLimitOld         Int // 87A: taxable income threshold, old regime
  rebateMaxOld           Int // 87A: max rebate amount, old regime
  rebateLimitNew         Int // 87A: taxable income threshold, new regime
  marginalReliefNew      Boolean @default(true) // 87A marginal relief, new regime
  npsEmployerCapPercent  Float // 80CCD(2) employer NPS cap, % of Basic+DA
  employerNpsPfPerqLimit Int // Sec 17: employer PF+NPS+Superannuation combined perquisite threshold
  surchargeConfig        String // JSON: [{threshold, rate, marginalRelief}]
  deductionLimits        String // JSON map: {"80C":150000, "80D_SELF_BELOW60":25000, ...}
  hraConfig              String // JSON: {metroPercent, nonMetroPercent}
  notes                  String? // free-text assumptions/disclaimers

  slabs TaxSlab[]
  rules TaxRule[]

  @@unique([financialYearId, regime, effectiveFrom])
}

model TaxSlab {
  id           String     @id @default(cuid())
  taxRuleSetId String
  taxRuleSet   TaxRuleSet @relation(fields: [taxRuleSetId], references: [id], onDelete: Cascade)
  ageCategory  String // BELOW_60 | SENIOR_60_79 | SUPER_SENIOR_80_PLUS
  minIncome    Int
  maxIncome    Int? // null = no upper bound
  rate         Float // e.g. 0.05 for 5%
  order        Int
}

// Human-readable catalog of every rule in force, for display + audit
// ("Rule name, Section/reference, FY, Regime, Effective date, Calculation
// method, Limit/threshold, Rate").
model TaxRule {
  id                String     @id @default(cuid())
  taxRuleSetId      String
  taxRuleSet        TaxRuleSet @relation(fields: [taxRuleSetId], references: [id], onDelete: Cascade)
  name              String
  section           String
  calculationMethod String
  limitValue        Float?
  rateValue         Float?
  assumptionWarning String? // shown in UI when the provision needed interpretation
}

// ---------------------------------------------------------------------------
// Employee Master
// ---------------------------------------------------------------------------

model Employee {
  id            String    @id @default(cuid())
  employeeCode  String    @unique
  fullName      String
  dob           DateTime?
  gender        String?
  pan           String?
  aadhaar       String?
  email         String?
  phone         String?
  dateOfJoining DateTime
  dateOfLeaving DateTime?
  department    String?
  designation   String?
  location      String?
  costCentre    String?
  payrollGroup  String?
  uan           String?
  pfApplicable  Boolean   @default(true)
  esiApplicable Boolean   @default(false)
  ptApplicable  Boolean   @default(true)
  taxRegime     String    @default("NEW") // OLD | NEW - selected regime for TDS
  ageCategory   String    @default("BELOW_60")
  status        String    @default("ACTIVE") // ACTIVE | INACTIVE | LEFT
  bankName      String?
  bankAccountNo String?
  bankIfsc      String?
  isMetroCity   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  salaryStructures        EmployeeSalaryStructure[]
  investmentDeclarations  InvestmentDeclaration[]
  previousEmployerIncomes PreviousEmployerIncome[]
  payrollLines            PayrollRunLine[]
}

// ---------------------------------------------------------------------------
// Salary Structure & Formula Engine
// ---------------------------------------------------------------------------

model SalaryComponent {
  id         String  @id @default(cuid())
  code       String  @unique // BASIC, HRA, SPECIAL_ALLOWANCE, EMPLOYER_PF, EMPLOYEE_PF, PT, TDS ...
  name       String
  category   String // EARNING | EMPLOYER_CONTRIBUTION | DEDUCTION
  taxability String  @default("TAXABLE") // TAXABLE | EXEMPT | PARTIALLY_EXEMPT
  formula    String? // e.g. "BASIC * 0.5" - resolved by the formula engine
  isFixed    Boolean @default(true) // fixed amount input vs. formula-derived
  order      Int     @default(0)

  values EmployeeSalaryComponentValue[]
}

model EmployeeSalaryStructure {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  annualCTC       Float
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  components EmployeeSalaryComponentValue[]

  @@index([employeeId, financialYearId])
}

model EmployeeSalaryComponentValue {
  id            String                  @id @default(cuid())
  structureId   String
  structure     EmployeeSalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  componentId   String
  component     SalaryComponent         @relation(fields: [componentId], references: [id])
  monthlyAmount Float
  annualAmount  Float
  formulaUsed   String? // resolved formula trace, e.g. "40% of CTC (1,200,000) = 480,000"
}

// ---------------------------------------------------------------------------
// Investment Declarations
// ---------------------------------------------------------------------------

model InvestmentDeclaration {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  // Section 80C basket
  lic                  Float @default(0)
  epf                  Float @default(0)
  ppf                  Float @default(0)
  elss                 Float @default(0)
  lifeInsurance        Float @default(0)
  tuitionFees          Float @default(0)
  housingLoanPrincipal Float @default(0)
  otherSection80C      Float @default(0)
  section80CCC         Float @default(0)
  section80CCD1        Float @default(0) // NPS employee contribution (within 80C cap)
  section80CCD1B       Float @default(0) // Additional NPS - separate 50k cap

  // Section 80D
  section80DSelfBelow60    Float @default(0)
  section80DParentsBelow60 Float @default(0)
  section80DSelfAbove60    Float @default(0)
  section80DParentsAbove60 Float @default(0)

  // Other deductions
  section80E            Float @default(0) // education loan interest
  section80EE           Float @default(0)
  section80EEA          Float @default(0)
  section80UBelow80     Float @default(0)
  section80U80AndAbove  Float @default(0)
  section80DDBelow80    Float @default(0)
  section80DD80AndAbove Float @default(0)
  donations80G          Float @default(0)

  // Home loan / house property
  homeLoanInterestSelfOccupied Float @default(0)
  letOutAnnualValue            Float @default(0)
  letOutMunicipalTax           Float @default(0)
  letOutHomeLoanInterest       Float @default(0)

  // HRA / rent
  monthlyRent   Float   @default(0)
  rentalAddress String?
  landlordName  String?
  landlordPan   String?

  // LTA & other
  ltaClaimed      Float  @default(0)
  otherDeductions Float  @default(0)
  proofStatus     String @default("PENDING") // PENDING | SUBMITTED | VERIFIED | REJECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, financialYearId])
}

// ---------------------------------------------------------------------------
// Previous employer income (mid-year joiners)
// ---------------------------------------------------------------------------

model PreviousEmployerIncome {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  employerName  String
  periodFrom    DateTime
  periodTo      DateTime
  grossSalary   Float
  taxableSalary Float
  exemptions    Float    @default(0)
  deductions    Float    @default(0)
  tdsDeducted   Float    @default(0)
  pfDeducted    Float    @default(0)
  notes         String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Payroll Processing
// ---------------------------------------------------------------------------

model PayrollRun {
  id                String        @id @default(cuid())
  financialYearId   String
  financialYear     FinancialYear @relation(fields: [financialYearId], references: [id])
  payrollMonthIndex Int // 1 = April ... 12 = March
  calendarYear      Int
  calendarMonth     Int // 1-12
  payrollGroup      String?
  status            String        @default("DRAFT") // DRAFT|CALCULATED|REVIEWED|APPROVED|LOCKED|PAID
  processedAt       DateTime?
  reviewedAt        DateTime?
  approvedAt        DateTime?
  lockedAt          DateTime?
  paidAt            DateTime?
  createdBy         String?
  createdAt         DateTime      @default(now())

  lines PayrollRunLine[]

  @@unique([financialYearId, payrollMonthIndex, payrollGroup])
}

model PayrollRunLine {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])

  daysInMonth Int
  daysWorked  Float
  lopDays     Float @default(0)

  earnings              String // JSON map componentCode -> amount
  grossSalary           Float
  employerContributions String // JSON map
  totalEmployerCost     Float
  deductions            String // JSON map (excluding TDS, which is separate)
  tdsMonthly            Float
  totalDeductions       Float
  netSalary             Float
  regimeUsed            String // OLD | NEW
  taxCalcSnapshot       String // JSON: { old: TaxCalcResult, new: TaxCalcResult }
  metrics               String // JSON: { hraExemptionThisMonth, basicPlusDaThisMonth, employerPfNpsSuperThisMonth, ptPaidThisMonth } - frozen at calc time

  createdAt DateTime @default(now())

  adjustments PayrollAdjustment[]

  @@unique([payrollRunId, employeeId])
}

model PayrollAdjustment {
  id               String         @id @default(cuid())
  payrollRunLineId String
  payrollRunLine   PayrollRunLine @relation(fields: [payrollRunLineId], references: [id], onDelete: Cascade)
  amount           Float
  reason           String
  enteredBy        String
  createdAt        DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Bank Payment Templates
// ---------------------------------------------------------------------------

model BankFileTemplate {
  id        String  @id @default(cuid())
  bankName  String
  code      String  @unique
  columns   String // JSON: [{header, field, format}]
  delimiter String  @default(",")
  isActive  Boolean @default(true)
}

// ---------------------------------------------------------------------------
// Import Wizard
// ---------------------------------------------------------------------------

model ImportBatch {
  id              String   @id @default(cuid())
  templateType    String // EMPLOYEE|SALARY_STRUCTURE|INVESTMENT|PREVIOUS_EMPLOYER|MONTHLY_PAYROLL
  fileName        String
  totalRecords    Int
  importedRecords Int
  failedRecords   Int
  status          String // COMPLETED|COMPLETED_WITH_ERRORS|FAILED
  createdAt       DateTime @default(now())

  errors ImportError[]
}

model ImportError {
  id            String      @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber     Int
  message       String
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  performedBy String?
  detail      String? // JSON
  createdAt   DateTime @default(now())
}
